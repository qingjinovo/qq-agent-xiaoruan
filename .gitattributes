# 一律用 LF 入库（脚本要传进 Linux 容器执行）
* text=auto eol=lf

# Windows 批处理必须是 CRLF（cmd.exe 对 LF 结尾的标签跳转有已知问题）
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制：避免 Git 做换行转换与文本 diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
